RewriteEngine On

# Audit funnel: /audit-form → booking (TidyCal) → /thankyou
RewriteRule ^audit-form/?$ /audit-form/index.html [L]

# Thank-you page after booking
RewriteRule ^thankyou/?$ /thankyou/index.html [L]

# SPA: serve index.html for client-side routes (skip real files/dirs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
